+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum TrackerState {
+    #[default]
+    NotContacted,
+    Working,
+    Failing,
+}
+
+/// What one tracker said the last time this torrent announced to it.
+#[derive(Clone, Debug, Default)]
+pub struct TrackerStatus {
+    pub state: TrackerState,
+    pub message: Option<String>,
+    pub peers: usize,
+    pub seeders: Option<u32>,
+    pub leechers: Option<u32>,
+    pub last_announce: Option<SystemTime>,
+    pub last_success: Option<SystemTime>,
+    pub failing_since: Option<SystemTime>,
+    pub failures: u32,
+}
+
+pub type TrackerStatuses = Arc<parking_lot::RwLock<HashMap<Url, TrackerStatus>>>;
