+    fn note(&self, url: &Url, result: &anyhow::Result<Announced>) {
+        let announced = match result {
+            Ok(announced) => announced,
+            Err(err) => return self.note_failure(url, err),
+        };
+        let now = SystemTime::now();
+        let mut statuses = self.status.write();
+        let status = statuses.entry(url.clone()).or_default();
+        status.state = TrackerState::Working;
+        status.message = None;
+        status.peers = announced.peers;
+        status.seeders = Some(announced.seeders);
+        status.leechers = Some(announced.leechers);
+        status.last_announce = Some(now);
+        status.last_success = Some(now);
+        status.failing_since = None;
+        status.failures = 0;
+    }
+
+    fn note_failure(&self, url: &Url, err: &anyhow::Error) {
+        let now = SystemTime::now();
+        let mut statuses = self.status.write();
+        let status = statuses.entry(url.clone()).or_default();
+        status.state = TrackerState::Failing;
+        status.message = Some(format!("{err:#}"));
+        status.last_announce = Some(now);
+        status.failing_since.get_or_insert(now);
+        status.failures += 1;
     }
 
